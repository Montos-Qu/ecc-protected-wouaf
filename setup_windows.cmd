@echo off
setlocal
set "WOUAF_PRODUCT_ROOT=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $root=$env:WOUAF_PRODUCT_ROOT; $profile=Get-Content -LiteralPath (Join-Path $root 'environment/portable/profile.json') -Raw -Encoding UTF8 | ConvertFrom-Json; $tools=Join-Path $root '.runtime/bootstrap'; New-Item -ItemType Directory -Path $tools -Force | Out-Null; $artifact=$profile.uv.artifacts.windows; $wheel=Join-Path $tools $artifact.filename; if (!(Test-Path -LiteralPath $wheel)) { Invoke-WebRequest -UseBasicParsing -Uri $artifact.url -OutFile $wheel }; $hash=[Security.Cryptography.SHA256]::Create(); $stream=[IO.File]::OpenRead($wheel); $actual=[BitConverter]::ToString($hash.ComputeHash($stream)).Replace('-','').ToLowerInvariant(); $stream.Dispose(); $hash.Dispose(); if ($actual -ne $artifact.sha256) { throw 'Bootstrap checksum mismatch' }; [Reflection.Assembly]::LoadWithPartialName('System.IO.Compression.FileSystem') | Out-Null; $zip=[IO.Compression.ZipFile]::OpenRead($wheel); $entry=@($zip.Entries | Where-Object { $_.Name -eq 'uv.exe' }); if ($entry.Count -ne 1) { throw 'Unexpected bootstrap layout' }; $uv=Join-Path $tools 'uv.exe'; [IO.Compression.ZipFileExtensions]::ExtractToFile($entry[0],$uv,$true); $zip.Dispose(); $env:UV_PYTHON_INSTALL_DIR=Join-Path $tools 'python'; $env:UV_PYTHON_BIN_DIR=Join-Path $tools 'bin'; $env:UV_CACHE_DIR=Join-Path $tools 'cache'; $env:UV_NO_CONFIG='1'; $env:PYTHONPATH=$null; $env:PYTHONHOME=$null; $env:VIRTUAL_ENV=$null; $env:CONDA_PREFIX=$null; & $uv --quiet --no-config python install $profile.python; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $python=& $uv --no-config python find --managed-python $profile.python; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & $python -I -X utf8 (Join-Path $root 'wouaf.py') setup; exit $LASTEXITCODE"
exit /b %errorlevel%

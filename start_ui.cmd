@echo off
setlocal
set "WOUAF_PRODUCT_ROOT=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $root=$env:WOUAF_PRODUCT_ROOT; $server=Join-Path $root 'outputs/ui_server.json'; if (Test-Path -LiteralPath $server) { try { $s=Get-Content -LiteralPath $server -Raw -Encoding UTF8 | ConvertFrom-Json; if ($s.url -match '^http://127\.0\.0\.1:[0-9]+$') { $health=Invoke-RestMethod -Uri ($s.url+'/api/health') -TimeoutSec 2; if ($health.application -eq 'ecc-wouaf-local-ui' -and $health.version -eq '3.0.7' -and $health.checkout_id -eq $s.checkout_id) { Start-Process -FilePath $s.url; exit 0 } } } catch {} }; $file=Join-Path $root 'outputs/portable_install.json'; $ready=$false; if (Test-Path -LiteralPath $file) { $r=Get-Content -LiteralPath $file -Raw -Encoding UTF8 | ConvertFrom-Json; $ready=$r.model_validation_passed -and (Test-Path -LiteralPath $r.python); if ($ready) { $hash=[Security.Cryptography.SHA256]::Create(); $stream=[IO.File]::OpenRead((Join-Path $root 'environment/portable/profile.json')); $actual=[BitConverter]::ToString($hash.ComputeHash($stream)).Replace('-','').ToLowerInvariant(); $stream.Dispose(); $hash.Dispose(); $ready=$actual -eq $r.profile_sha256 } }; if (!$ready) { & (Join-Path $root 'setup_windows.cmd'); if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } }; $r=Get-Content -LiteralPath $file -Raw -Encoding UTF8 | ConvertFrom-Json; $args=@('-I','-X','utf8',([char]34+(Join-Path $root 'wouaf.py')+[char]34),'ui'); Start-Process -FilePath $r.python -ArgumentList $args -WorkingDirectory $root -WindowStyle Hidden -RedirectStandardOutput (Join-Path $root 'outputs/ui_stdout.log') -RedirectStandardError (Join-Path $root 'outputs/ui_stderr.log'); Write-Host 'Opening WOUAF Studio in your browser. Use Stop app in the page to exit.';"
if errorlevel 1 pause
exit /b %errorlevel%
